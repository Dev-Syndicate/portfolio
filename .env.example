# Copy this file to `.env.local` and fill in real values. Do NOT commit .env.local.

# Resend API key. Create at https://resend.com/api-keys — use a key scoped to
# "Sending access" only. Treat as a secret; rotate if it ever leaks.
RESEND_API_KEY=

# Inbox that receives enquiries. Defaults to the site email if unset.
CONTACT_TO_EMAIL=

# Verified sender on our own domain (must be a domain verified in Resend).
# Format: "Display Name <address@domain.in>"
CONTACT_FROM_EMAIL=
